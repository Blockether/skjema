;; skjema — fast JSON Schema 2020-12 validation for Clojure.
;; Charred owns JSON; Clojure owns the API, Java owns everything it walks over.
{:paths ["src" "resources" "target/classes"]
 :deps/prep-lib {:alias :build
                 :fn compile-java
                 :ensure "target/classes/com/blockether/skjema/Schemas.class"}

 :deps {com.cnuernber/charred {:mvn/version "1.041"}}

 :aliases
 {:build
  {:extra-paths ["."]
   :deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}
          slipset/deps-deploy           {:mvn/version "0.2.5"}}
   :ns-default build}

  ;; Official JSON Schema conformance plus focused API and error tests.
  :test
  {:extra-paths ["test"]
   :extra-deps  {org.clojure/clojure            {:mvn/version "1.12.4"}
                 io.github.noahtheduke/lazytest {:mvn/version "2.0.0"}}
   :main-opts   ["-m" "lazytest.main" "test"]}

  ;; Compiled validation benchmarked over identical parsed values.
  :bench
  {:extra-paths ["bench"]
   :extra-deps  {org.clojure/clojure {:mvn/version "1.12.4"}
                 metosin/malli       {:mvn/version "0.20.1"}
                 criterium/criterium {:mvn/version "0.4.6"}}
   :main-opts   ["-m" "com.blockether.skjema.bench"]}}}
